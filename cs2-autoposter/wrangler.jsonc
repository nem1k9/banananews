{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cs2-news-autoposter",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/webhooks/*"],
  },
  "vars": {
    "MODE": "dry-run",
    "PROVIDER": "mock",
    "POLL_SECONDS": "10",
    "PROVIDER_MIN_POLL_SECONDS": "10",
    "PROVIDER_POLLING_APPROVED": "false",
    "CODEX_ENABLED": "false",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cs2-autoposter",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "MATCHES", "class_name": "MatchMonitor" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MatchMonitor"] }],
  "triggers": { "crons": ["* * * * *"] },
  "rules": [
    { "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true },
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true },
  ],
  "observability": { "enabled": true },
}
