# Copy to .dev.vars for Wrangler. Never copy the real channel token into dry-run examples.
ADMIN_TOKEN=replace-with-random-32-byte-secret
RUNNER_TOKEN=replace-with-different-random-secret
PROVIDER_WEBHOOK_TOKEN=replace-with-different-random-secret
MODE=dry-run
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# Mandatory separate allowlist for MODE=test. Use only a private test channel ID.
TELEGRAM_TEST_CHANNEL_ID=
# MODE=production additionally requires PRODUCTION_CONFIRM=I_UNDERSTAND_LIVE_POSTING
PRODUCTION_CONFIRM=
PROVIDER=mock
PANDASCORE_TOKEN=
# Enable frequent live polling only if your contract permits it.
PROVIDER_POLLING_APPROVED=false
PROVIDER_MIN_POLL_SECONDS=10
POLL_SECONDS=10
CODEX_ENABLED=false
